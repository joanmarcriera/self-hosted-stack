# Copy this file to .secrets/server-reset-handoff.env and fill the real values.

BASE_DOMAIN=example.com
OWNER_NAME="Founder Name"
OWNER_EMAIL=founder@example.com
TZ=Europe/London

# Authentik SMTP
AUTHENTIK_EMAIL_HOST=smtp.gmail.com
AUTHENTIK_EMAIL_PORT=587
AUTHENTIK_EMAIL_USERNAME=founder@example.com
AUTHENTIK_EMAIL_PASSWORD=replace-with-16-char-app-password-no-spaces
AUTHENTIK_EMAIL_USE_TLS=true
AUTHENTIK_EMAIL_USE_SSL=false
AUTHENTIK_EMAIL_TIMEOUT=10
AUTHENTIK_EMAIL_FROM=founder@example.com

# n8n owner identity after rebuild
N8N_OWNER_EMAIL=founder@example.com

# Optional: keep deterministic local app access instead of rotating on rebuild
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=

# Optional: preserve generated secrets instead of letting the scripts rotate them
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=
AUTHENTIK_SECRET_KEY=
N8N_BASIC_AUTH_PASSWORD=
N8N_ENCRYPTION_KEY=
BOOKSTACK_APP_KEY=
BOOKSTACK_OIDC_CLIENT_ID=
BOOKSTACK_OIDC_CLIENT_SECRET=
ESPOCRM_OIDC_CLIENT_ID=
ESPOCRM_OIDC_CLIENT_SECRET=
VIKUNJA_JWT_SECRET=
VIKUNJA_OIDC_CLIENT_ID=
VIKUNJA_OIDC_CLIENT_SECRET=
GRAFANA_OIDC_CLIENT_ID=
GRAFANA_OIDC_CLIENT_SECRET=

# Optional off-host backup
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
