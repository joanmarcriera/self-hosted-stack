## Codex-managed: command execution + critical auth/config file changes
## Capture all root command executions (interactive + non-interactive)
-a always,exit -F arch=b64 -S execve -F uid=0 -k exec_root
-a always,exit -F arch=b32 -S execve -F uid=0 -k exec_root
## Capture regular user sessions (auid-backed)
-a always,exit -F arch=b64 -S execve -F auid>=1000 -F auid!=4294967295 -k exec_user
-a always,exit -F arch=b32 -S execve -F auid>=1000 -F auid!=4294967295 -k exec_user

-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k priv_esc
-w /etc/sudoers.d -p wa -k priv_esc
-w /etc/ssh/sshd_config -p wa -k ssh_config
-w /etc/ssh/sshd_config.d -p wa -k ssh_config
-w /root/.ssh/authorized_keys -p wa -k ssh_keys
