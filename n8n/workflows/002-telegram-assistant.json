    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const text = ($json.message?.text || '').trim();\nconst chatId = $json.message?.chat?.id;\nif (!chatId) throw new Error('No Telegram chat id in payload');\n\nlet replyText = '';\nif (text === '/ping') {\n  replyText = 'pong';\n} else if (text === '/id') {\n  replyText = `chat_id: ${chatId}`;\n} else if (text === '/help' || text === '/start') {\n  replyText = [\n    'Available commands:',\n    '/ping - check bot is alive',\n    '/id - show your chat id',\n    '/help - show this help',\n    '',\n    'Tomorrow we will attach Gmail potato flow to this bot.'\n  ].join('\\n');\n} else {\n  replyText = 'Unknown command. Send /help';\n}\n\nreturn { json: { chatId: String(chatId), replyText } };"
      },
      "id": "4b8e0f5c-4f0d-4fd9-ab0a-0f2747c5e902",
      "name": "Build Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
