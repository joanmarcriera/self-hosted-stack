      "typeVersion": 1,
      "position": [180, 40]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "family-activity",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "37a55ff7-aaa3-4db0-9d53-8514f4b906dd",
      "name": "Activity Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [300, 380]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body || $json;\nconst kid = body.kid || body.child || 'Unknown';\nconst activity = body.activity || body.event || 'Unknown activity';\nconst when = body.when || body.date || 'TBD';\n\nreturn {\n  json: {\n    kid,\n    activity,\n    when,\n    location: body.location || '',\n    notes: body.notes || '',\n    createdAt: new Date().toISOString(),\n    chatId: 'REPLACE_CHAT_ID',\n    telegramText: `Activity saved: ${kid} - ${activity} (${when})`\n  }\n};"
      },
      "id": "9e7c3019-5f6a-45df-bb4c-fb8fcad14437",
      "name": "Normalize Activity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [580, 380]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "sheet",
        "operation": "append",
        "documentId": {
          "mode": "id",
          "value": "REPLACE_SPREADSHEET_ID"
        },
        "sheetName": {
          "mode": "name",
          "value": "Activities"
        },
        "options": {}
      },
      "id": "2a080a2c-2f33-49d8-a497-ad550c711cc7",
      "name": "Google Sheets Activities",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [860, 300]
    },
