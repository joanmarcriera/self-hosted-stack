      "typeVersion": 1,
      "position": [180, 40]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sme-lead-autoreply",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "d1faa0b8-cdb7-408c-b01e-d9d31e31c0cf",
      "name": "Lead Reply Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [300, 380]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body || $json;\nconst toEmail = body.email || '';\nif (!toEmail) throw new Error('Missing lead email');\n\nconst name = body.name || 'there';\nconst company = body.company || 'your company';\n\nreturn {\n  json: {\n    toEmail,\n    subject: `Thanks for reaching out, ${name}` ,\n    message: [\n      `Hi ${name},`,\n      '',\n      `Thanks for contacting us about automation for ${company}.`,\n      'We received your message and will get back to you shortly with next steps.',\n      '',\n      'Best,',\n      'Marc'\n    ].join('\\n'),\n    internalText: `Auto-reply sent to ${toEmail}`\n  }\n};"
      },
      "id": "744835ef-3d15-4a47-b4e6-4e4ae0073d11",
      "name": "Build Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [580, 380]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "message",
        "operation": "send",
        "sendTo": "={{$json.toEmail}}",
        "subject": "={{$json.subject}}",
        "emailType": "text",
        "message": "={{$json.message}}",
        "options": {}
      },
      "id": "3a503547-814b-45bd-a1b5-b74e734071ca",
      "name": "Gmail Send",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [860, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "REPLACE_CHAT_ID",
        "text": "={{$json.internalText}}",
        "additionalFields": {}
      },
      "id": "61009c79-d005-4c70-aa59-ef8cf56261ec",
      "name": "Telegram Internal Ping",
      "type": "n8n-nodes-base.telegram",
